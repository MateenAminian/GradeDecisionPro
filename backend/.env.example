# Put real keys in backend/.env — never commit them.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# CardSight sold-auction comps. Backend only; never expose this as EXPO_PUBLIC_*.
CARDSIGHTAI_API_KEY=

# eBay Browse API (live listings / asking prices). App ID + Cert ID from developer.ebay.com.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
COMP_CACHE_TTL_SECONDS=86400

# Public HTTPS URL of GET/POST /api/v1/ebay/marketplace-deletion (required to enable production keys).
# Token: 32-80 chars, letters/numbers/hyphen/underscore. Must match the eBay Application Keys form.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
